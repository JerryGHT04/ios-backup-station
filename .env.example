# ios-backup-station settings
# Copy this file to ".env" and edit it (or just run ./install.sh, which does it for you):
#     cp .env.example .env

# [REQUIRED] The NAS folder where backups are stored. Use the full path of a folder that already exists.
# 备份要保存到的 NAS 文件夹，写完整路径，文件夹要已经存在。
# Examples / 例如:
#     /vol1/1000/ios-backups        (fnOS)
#     /volume1/ios-backups          (Synology)
#     /mnt/tank/ios-backups         (TrueNAS, Unraid, plain Linux)
# Do not leave this empty: without it the stack refuses to start, so backups can never be
# written inside the container by accident.
BACKUP_LOCATION=

# Port of the web page.
PORT=8899

# Where the settings, the web password and the pairing records are kept. Defaults to folders next
# to docker-compose.yml. Keep them: deleting them means setting the password and pairing again.
#CONFIG_LOCATION=./config
#LOCKDOWN_LOCATION=./lockdown

# Use a prebuilt image instead of building on the NAS (saves 5-10 minutes on the first start).
#IBS_IMAGE=ghcr.io/jerryght04/ios-backup-station:latest

# If downloads from deb.debian.org are slow where you are, build with a mirror, for example:
#APT_MIRROR=mirrors.ustc.edu.cn
